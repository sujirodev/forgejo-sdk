    {
      "route": "GetActionsRun",
      "versions": [
        "*"
      ],
      "reason": "needs-config",
      "detail": "authenticates with the ephemeral per-job ACTIONS_RUNTIME_TOKEN, which only exists inside a running Actions job; the integration suite calls the API externally with a regular admin token and can never legitimately hit this route",
      "issue": "https://codeberg.org/sujirodev/forgejo-sdk/issues/56",
      "since": ""
    },
    {
      "route": "GetSSHSigningKey",
      "versions": [
        "*"
      ],
      "reason": "needs-config",
      "detail": "404s because neither the local Docker instance nor the CI ephemeral instance configures an instance SSH signing key; unlike the GPG counterpart, Forgejo has no lazy default for it",
      "issue": "https://codeberg.org/sujirodev/forgejo-sdk/issues/56",
      "since": ""
    },
    {
      "route": "AdminAdoptRepository",
      "versions": [
        "*"
      ],
      "reason": "negative-only",
      "detail": "adopts a directory that exists under the server's repository root on disk but isn't tracked in the database; there's no way to create that state through the REST API, so the test can only exercise the request against a path guaranteed not to exist (a 404)",
      "issue": "https://codeberg.org/sujirodev/forgejo-sdk/issues/60",
      "since": ""
    },
    {
      "route": "AdminDeleteUnadoptedRepository",
      "versions": [
        "*"
      ],
      "reason": "negative-only",
      "detail": "same missing setup as AdminAdoptRepository -- no way to create an unadopted directory through the API",
      "issue": "https://codeberg.org/sujirodev/forgejo-sdk/issues/60",
      "since": ""
    },
    {
      "route": "StarRepo",
      "versions": [
        "latest-stable"
      ],
      "reason": "known-bug",
      "detail": "500s on Forgejo 16.0.5 once [federation] is enabled (needed for GetNodeInfo/ActivityPub); 11.0.16 and 15.0.9 are unaffected and still held to real evidence",
      "issue": "https://codeberg.org/sujirodev/forgejo-sdk/issues/59",
      "since": ""
    },
    {
      "route": "IsRepoStarring",
      "versions": [
        "latest-stable"
      ],
      "reason": "known-bug",
      "detail": "TestRepoStaring skips on this leg once StarRepo 500s (issue #59), so only the pre-star \"false\" (404) answer is ever recorded here, which looks like a bare failure without the \"true\" (204) evidence the rest of the test would add",
      "issue": "https://codeberg.org/sujirodev/forgejo-sdk/issues/59",
      "since": ""
    },
    {
      "route": "GetStarredRepos",
      "versions": [
        "latest-stable"
      ],
